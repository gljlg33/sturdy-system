# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# --- desk process (bots) ---
DESK_MODE=shadow                 # shadow | paper. There is no live mode.
JUDGE_URL=http://127.0.0.1:8787
DESK_SYMBOLS=BTC-USD
BLOCK_SECONDS=60
DESK_LOG_DIR=var/logs

# --- shared by desk and judge ---
JEV_MODEL=                       # exact pinned version string. "jev-latest" is refused.
DESK_SECRET=                     # >= 32 random chars, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`

# --- judge process only ---
# JEV_API_KEY is set only in the judge's environment, never in the desk's.
# Not added yet: needs your approval first.
JEV_API_KEY=
